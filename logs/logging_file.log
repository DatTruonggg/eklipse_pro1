.401}, page_content='Are you buying\nthe Harry Potter books?'), Document(metadata={'start_time': '609.175', 'duration': 0.534}, page_content='Yes.'), Document(metadata={'start_time': '611.611', 'duration': 1.067}, page_content='Are you buying the phone calls?'), Document(metadata={'start_time': '612.678', 'duration': 0.935}, page_content='- No.\n- No.'), Document(metadata={'start_time': '614.747', 'duration': 2.903}, page_content='We finally got you two to buy something.'), Document(metadata={'start_time': '617.65', 'duration': 2.302}, page_content='This feels good.\nIt was a pleasure doing business.'), Document(metadata={'start_time': '619.986', 'duration': 1.234}, page_content='Thanks for taking your money.'), Document(metadata={'start_time': '621.22', 'duration': 2.202}, page_content='Most expensive coffee\nmaker in the world.'), Document(metadata={'start_time': '623.456', 'duration': 2.102}, page_content="30 days in, we got something\nnew, that's exciting."), Document(metadata={'start_time': '625.591', 'duration': 1.468}, page_content="We caved. You're welcome."), Document(metadata={'start_time': '627.059', 'duration': 1.001}, page_content="That's my closet."), Document(metadata={'start_time': '628.26', 'duration': 1.102}, page_content="That's my bookshelf."), Document(metadata={'start_time': '629.362', 'duration': 1.901}, page_content='I could stay another 70 days easy.'), Document(metadata={'start_time': '631.33', 'duration': 2.87}, page_content='And we still have $480,000 It’s crazy.'), Document(metadata={'start_time': '634.233', 'duration': 1.235}, page_content='Over the next few days.'), Document(metadata={'start_time': '635.501', 'duration': 1.101}, page_content='Not a lot happened.'), Document(metadata={'start_time': '636.602', 'duration': 2.469}, page_content="- She's already preparing a meal.\n- It's like being married."), Document(metadata={'start_time': '639.105', 'duration': 1.434}, page_content='The most interesting thing was\nwhen'), Document(metad